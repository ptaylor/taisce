{
  "name": "Taisce — Markdown notes",
  "short_name": "Taisce",
  "description": "Read and edit Markdown notes stored in your own Dropbox.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f8fa",
